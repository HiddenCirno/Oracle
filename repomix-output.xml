        {
            public static bool Prefix(ActiveHealthController __instance)
            {
                if (!__instance.Player.IsYourPlayer) return true;

                if (GodModeCfg.Invincible.Value || GodModeCfg.HealthLock.Value || GodModeCfg.Undying.Value)
                {
                    return false;
                }

                return true;
            }
        }
    }

